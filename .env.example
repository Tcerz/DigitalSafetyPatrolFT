# Salin menjadi .env lalu ganti nilainya sebelum `docker compose up`.
# Gunakan huruf/angka saja pada password agar aman dipakai di URL database.
MYSQL_ROOT_PASSWORD=ganti_root_password_123
DB_PASSWORD=ganti_password_service_123
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
INTERNAL_KEY=ganti-dengan-kunci-internal-acak-minimal-32
JWT_EXPIRES_IN=8h
FRONTEND_PORT=8080
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:8080,http://localhost:5173
# Seed user demo (superadmin/admin/petugas). Set SEED_ON_START=false di production.
SEED_ON_START=true
SEED_PASSWORD=Password123!

# --- CI/CD (image dari Docker Hub) ---
# Username Docker Hub tempat pipeline mengirim image (dipakai docker-compose.hub.yml)
DOCKERHUB_USERNAME=NAMAUSER
# latest = rilis terbaru; atau pakai versi (mis. 1.1.0) / sha-xxxxxxx untuk mengunci versi tertentu
IMAGE_TAG=latest
