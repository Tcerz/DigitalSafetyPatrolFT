FROM node:20-slim
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev
COPY prisma ./prisma
# Generate Prisma client + buat migration awal dari schema.prisma (saat build image)
RUN export DATABASE_URL="mysql://build:build@localhost:3306/build" \
 && npx prisma generate \
 && mkdir -p prisma/migrations/00000000000000_init \
 && ( npx prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script > prisma/migrations/00000000000000_init/migration.sql 2>/dev/null \
      || npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/00000000000000_init/migration.sql ) \
 && test -s prisma/migrations/00000000000000_init/migration.sql \
 && printf '# Please do not edit this file manually\nprovider = "mysql"\n' > prisma/migrations/migration_lock.toml
COPY src ./src
COPY scripts ./scripts

ENV NODE_ENV=production
USER node
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["./scripts/entrypoint.sh"]
