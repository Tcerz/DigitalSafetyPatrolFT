# =====================================================
# .gitignore - Digital Safety Patrol
# Letakkan di ROOT repository (sejajar dengan folder
# frontend/, backend/ atau services/, dan docker-compose.yml)
# =====================================================

# ---------- Dependencies ----------
node_modules/

# ---------- Environment & rahasia (JANGAN PERNAH di-commit) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Hasil build ----------
dist/
build/
.vite/
*.local

# ---------- File unggahan (foto dokumentasi) ----------
uploads/

# ---------- Log ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Data & backup database ----------
mysql_data/
*.sql.bak
backup*.sql
*.dump

# ---------- Testing / coverage ----------
coverage/
.nyc_output/

# ---------- File sementara & arsip ----------
*.tmp
*.temp
*.zip

# ---------- Sistem operasi ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
