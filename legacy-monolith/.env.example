PORT=3000
NODE_ENV=development
# Lokal (tanpa Docker): host = localhost. Di Docker Compose, host = mysql (diatur otomatis oleh docker-compose.yml).
DATABASE_URL=mysql://safety:safety_pass@localhost:3306/safety_patrol
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
# Boleh lebih dari satu, pisahkan dengan koma
FRONTEND_URL=http://localhost:5173,http://localhost:8080
MAX_FILE_SIZE_MB=5
MAX_PHOTOS_PER_REPORT=10
# Hanya untuk development
SEED_PASSWORD=Password123!
TZ=Asia/Jakarta
